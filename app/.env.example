# Copy to .env and restart `npm run dev` after any change (Vite reads env at start).

# 143 = Monad mainnet or a local anvil fork of it. 10143 = Monad testnet (Open Bucket test pool instead of Aave).
VITE_CHAIN_ID=143
# Reads go here. Default: https://rpc.monad.xyz (143) or https://testnet-rpc.monad.xyz (10143).
# Point at http://127.0.0.1:8545 for the fork: that turns on the fork banner and the #crash screen.
VITE_RPC_URL=
# MonadVision base URL. Default: https://monadvision.com (143) or https://testnet.monadvision.com (10143).
VITE_EXPLORER=

# Open Bucket factory (from the contracts team's deploy). Routes and "Your buckets" stay empty until it is set.
VITE_FACTORY=

# Lending pool, oracle and tokens. On chain 143 these default to the VERIFIED values in docs/onchain-facts.md,
# so leave them empty for mainnet and the fork. On testnet set the team's test pool, test oracle, test USDC and TestWETH.
VITE_AAVE_POOL=
VITE_AAVE_ORACLE=
VITE_USDC=
# Collateral token (WETH on mainnet; TestWETH with faucet() on testnet).
VITE_COLLATERAL=

# Agent (keeper): yields proxy, SSE log stream and fork demo endpoints.
VITE_AGENT_URL=http://localhost:8787
VITE_AGENT_SSE=http://localhost:8787/events

# Crash screen (fork only). Printed by the agent's fork:setup.
VITE_PLAIN_POSITION=
VITE_DEMO_BUCKET=
