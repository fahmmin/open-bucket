# Copy to .env (never commit .env). Empty means unset.

# 143 = Monad mainnet (also the anvil fork), 10143 = Monad testnet
CHAIN_ID=143
# HTTP JSON-RPC. Mainnet https://rpc.monad.xyz, testnet https://testnet-rpc.monad.xyz, fork http://127.0.0.1:8545
RPC_URL=https://rpc.monad.xyz
# Optional block subscriptions (newHeads). Mainnet: wss://rpc.monad.xyz. Empty = HTTP polling (400 ms public, 250 ms fork)
WS_URL=wss://rpc.monad.xyz
# BucketFactory. Empty = watch nothing (the server still runs). On the fork it comes from contracts/fork-demo.json
FACTORY=
# 1 = log decisions only: the keeper and liquidator never send
DRY_RUN=1
# Burner key that pays gas for exit(). Required unless DRY_RUN=1. Never logged.
PRIVATE_KEY=
PORT=8787

# Aave (or our test pool on testnet). On CHAIN_ID=143 these default to the VERIFIED values in docs/onchain-facts.md:
# Pool 0x69a5F9AD4f96ebf0a0C792dD42a01cC5C0102fef, AaveOracle 0x0c02b2c2038066C10Eab8fe1D5Cdb73d5a78A1Bf,
# WETH 0xEE8c0E9f1BFFb4Eb878d8f15f368A02a35481242, USDC 0x754704Bc059F8C67012fEd69BC8A327a5aafb603.
# On testnet set them to the deployed TestPool, TestOracle, TestWETH and TestUSDC.
AAVE_POOL=
AAVE_ORACLE=
# The collateral whose price the demo moves (WETH; TestWETH on testnet)
COLLATERAL=
USDC=

# Plain-position liquidator (fork or testnet only). On the fork PLAIN_POSITION comes from contracts/fork-demo.json
LIQUIDATE_PLAIN=0
PLAIN_POSITION=
# Testnet only: pays for liquidationCall (the fork uses anvil dev account #3)
LIQUIDATOR_KEY=
# Testnet only: owner of TestOracle, enables POST /testnet/price
ORACLE_ADMIN_KEY=

# npm run fork:start: the RPC anvil forks from
MONAD_RPC_URL=https://rpc.monad.xyz
